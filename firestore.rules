rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'username', 'name', 'avatarUrl'])
        && data.id is string
        && data.username is string
        && data.name is string
        && data.avatarUrl is string;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['id', 'userId', 'username', 'mediaUrls', 'caption', 'likesCount'])
        && data.id is string
        && data.userId is string
        && data.username is string
        && data.mediaUrls is list
        && data.caption is string
        && data.likesCount is number;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'userId', 'username', 'text'])
        && data.id is string
        && data.userId is string
        && data.username is string
        && data.text is string;
    }

    function isValidLike(data) {
      return data.keys().hasAll(['userId'])
        && data.userId is string;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isValidPost(request.resource.data);
      allow update: if isAuthenticated()
        && (
          (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidPost(request.resource.data))
          || (isValidPost(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'updatedAt']))
        );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Post Likes subcollection
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(userId) && isValidLike(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && isValidComment(request.resource.data);
        allow update: if isAuthenticated()
          && (
            (resource.data.userId == request.auth.uid && isValidComment(request.resource.data))
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
          );
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid);
      }
    }
  }
}
